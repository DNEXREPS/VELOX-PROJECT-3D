# -----------------------------------------------------------------------------
# VELOX Digital Garage — environment variables
# Copy to .env.local and fill in. Never commit real values.
# -----------------------------------------------------------------------------

# Supabase project (Project Settings → API). Safe to expose to the browser:
# access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public origin of this deployment (used for auth email redirects and share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY. Used exclusively by scripts/import-catalog.ts (catalogue import CLI).
# The web application never reads this variable and it must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Postgres URL for the RLS integration test-suite (see scripts/db-local.sh).
# DATABASE_URL=postgresql://postgres@127.0.0.1:54329/velox
