# -----------------------------------------------------------------------------
# VELOX Digital Garage — environment variables
# Copy to .env.local for local development. On Vercel, set these per environment
# (Production / Preview) in Project Settings → Environment Variables.
# Never commit real values. Run `npm run env:check` to validate a configuration.
# -----------------------------------------------------------------------------

# --- Public (inlined into the browser bundle; safe: access is enforced by RLS) ---
# Supabase project URL and anon/publishable key (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public origin of this deployment: auth e-mail links, share links, metadata.
# REQUIRED in production. On Vercel *preview* deployments it may be left unset: the
# branch URL (VERCEL_BRANCH_URL) is used instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------------
# Service-role key. Used ONLY by the scheduled storage-cleanup route
# (/api/cron/storage-cleanup, server-only module src/server/supabase-admin.ts) and the
# catalogue import CLI. It bypasses RLS: keep it out of Preview environments that run
# untrusted branches if you do not need cleanup there.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# At least 32 random characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Optional: comma-separated hostnames allowed for external component images
# (rendered and permitted by the CSP). Supabase Storage is always allowed.
IMAGE_HOSTS_ALLOWLIST=

# Optional: forward monitoring events (JSON) to an HTTPS endpoint in addition to the
# structured log lines. MONITORING_WEBHOOK_TOKEN is sent as a Bearer token.
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TOKEN=

# --- Tests only ------------------------------------------------------------------
# Postgres URL for the database security suite (see scripts/db-local.sh).
# DATABASE_URL=postgresql://postgres@127.0.0.1:54329/velox
