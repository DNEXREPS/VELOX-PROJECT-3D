{
  "name": "velox-digital-garage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:watch": "vitest tests/unit",
    "test:e2e": "node tests/e2e/journey.e2e.mjs",
    "test:e2e:security": "node tests/e2e/security.e2e.mjs",
    "db:local": "scripts/db-local.sh start",
    "db:local:stop": "scripts/db-local.sh stop",
    "db:seed:build": "tsx scripts/build-seed.ts",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts",
    "db:push:dry": "supabase db push --dry-run",
    "db:checksums": "tsx scripts/migration-checksums.ts",
    "model:generate": "tsx scripts/generate-placeholder-model.mts",
    "catalog:import": "tsx scripts/import-catalog.ts",
    "env:check": "tsx scripts/check-env.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.108.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@hookform/resolvers": "^7.0.7",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "gltf-validator": "^2.0.0-dev.3.10",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
